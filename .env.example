# Contact form (server-side, Resend)
# Create a Resend account, then add the API key below. Never use NEXT_PUBLIC_ for this value.
RESEND_API_KEY=

# Verified sender shown to the recipient. For Resend test mode use:
# JOILIN S M Portfolio <beth.t@example.com>
# For production, use an address on a domain you have verified with Resend.
CONTACT_FROM_EMAIL=
